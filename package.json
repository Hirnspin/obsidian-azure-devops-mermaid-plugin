{
  "name": "obsidian-azure-devops-mermaid-plugin",
  "version": "0.1.0",
  "description": "Obsidian plugin to render Azure DevOps :::mermaid syntax.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "check": "tsc --noEmit"
  },
  "keywords": ["obsidian", "azure devops", "mermaid"],
  "author": "Sebastian Hoesl",
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.0.1",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.8",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2"
  }
}
