{
  "name": "obsidian-azure-devops-mermaid-plugin",
  "version": "0.1.1",
  "description": "Obsidian plugin to render Azure DevOps :::mermaid syntax.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "check": "tsc --noEmit",
    "release": "powershell -File release.ps1"
  },
  "keywords": [
    "obsidian",
    "azure devops",
    "mermaid"
  ],
  "author": {
    "name": "Hirnspin",
    "url": "https://github.com/Hirnspin/obsidian-azure-devops-mermaid-plugin"
  },
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hirnspin/obsidian-azure-devops-mermaid-plugin.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.0.1",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.8",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2"
  }
}
